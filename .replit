modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
GOOGLE_REDIRECT_URI = "https://81ea024b-7dcc-4d12-8980-329ab76f41ef-00-3pfnigp3oiasq-tlblixk5.janeway.replit.dev/api/admin/calendar/callback"
